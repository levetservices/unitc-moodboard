{
  "name": "unitc-moodboard",
  "version": "1.0.0",
  "description": "Self-hosted lighting and sound moodboard. Public to view, owner login to edit.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "hash-password": "node scripts/hash-password.mjs",
    "test": "node scripts/smoke-test.mjs"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1"
  },
  "license": "MIT"
}
