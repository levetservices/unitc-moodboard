# Copy this file to .env and fill it in. `npm start` and `npm run dev` read it automatically.
# Don't `source .env` in a shell: the hash below contains $ signs and the shell will eat them.

# Login used on the site. Pick anything.
ADMIN_USER=hayden

# Run `npm run hash-password` (or `docker compose run --rm moodboard npm run hash-password`)
# and paste the result here. The password itself is never stored.
ADMIN_PASSWORD_HASH=

# Quick-start alternative to the hash. Delete this line once you've set the hash.
# ADMIN_PASSWORD=change-me

# Set to 1 once the site is behind HTTPS (Nginx Proxy Manager, Caddy, Cloudflare tunnel).
COOKIE_SECURE=0
# Set to 1 when running behind a reverse proxy so login rate limiting sees real IPs.
TRUST_PROXY=0

# Largest single upload, in MB.
MAX_UPLOAD_MB=500

PORT=3000
